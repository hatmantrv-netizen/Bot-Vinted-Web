# =============================================================================
# VINTED SNIPER WEB — Configuration
# =============================================================================

# 🔐 SÉCURITÉ — OBLIGATOIRE EN PRODUCTION
# Génère une clé robuste avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-moi-en-production

# Mettre "true" en production (HTTPS) : empêche le cookie d'être envoyé en HTTP
SECURE_COOKIE=false

# 👤 ADMIN — Email du compte admin (auto-promu à la connexion)
# Seul cet email aura accès à la section Admin (Codes d'invitation)
INITIAL_ADMIN_EMAIL=brashow@proton.me

# Désactive l'inscription publique (utile une fois ton public capté)
ALLOW_REGISTRATION=true

# ⚙️ APP
HOST=0.0.0.0
PORT=8000
CHECK_INTERVAL=20             # Délai entre 2 scans en secondes (20s = bon compromis)
DB_NAME=vinted_sniper.db

# ⏱️ ESSAI GRATUIT
TRIAL_DURATION_DAYS=7         # Nombre de jours d'essai à l'inscription
MAX_FILTERS_FREE=3            # Limite de filtres apres l'essai (tier 'free')
