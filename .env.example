# =============================================================================
# VINTED SNIPER WEB — Configuration
# =============================================================================

# 🔐 SÉCURITÉ — OBLIGATOIRE EN PRODUCTION
# Génère une clé robuste avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-moi-en-production
SECURE_COOKIE=false

# 👤 ADMIN
INITIAL_ADMIN_EMAIL=brashow@proton.me
ALLOW_REGISTRATION=true

# ⚙️ APP
HOST=0.0.0.0
PORT=8000
CHECK_INTERVAL=20             # Délai entre 2 scans en secondes
DB_NAME=vinted_sniper.db

# ⏱️ ESSAI GRATUIT
TRIAL_DURATION_DAYS=7
MAX_FILTERS_FREE=3

# 🤖 BOT — FILTRAGE TEMPOREL STRICT (anti-vieilles-annonces)
# Les annonces de plus de X secondes sont REJETÉES (Vinted remonte parfois des annonces
# de plusieurs mois quand le vendeur les "boost"). 600s = 10 min.
# Mets 300 pour être plus strict (5 min), 1800 pour être plus tolérant (30 min).
MAX_ITEM_AGE_SECONDS=600

# =============================================================================
# 💳 STRIPE — Paiements (abonnements Pro)
# =============================================================================
# 1. Crée un compte sur https://dashboard.stripe.com
# 2. Récupère tes clés dans Developers > API Keys
# 3. Crée un produit avec un prix récurrent (ex: 9.90€/mois)
# 4. Copie l'ID du prix (ex: price_1AbCdEfGhIjKlMnO)
# 5. Configure un webhook dans Developers > Webhooks pointant vers :
#    https://ton-domaine.com/api/payments/stripe/webhook
#    Événements à écouter : checkout.session.completed, customer.subscription.deleted
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_SUCCESS_URL=http://localhost:8000/?payment=success
STRIPE_CANCEL_URL=http://localhost:8000/?payment=cancelled

# =============================================================================
# 🅿️ PAYPAL — Paiements alternatifs (abonnements)
# =============================================================================
# 1. Crée un compte sur https://developer.paypal.com
# 2. Crée une app dans My Apps & Credentials
# 3. Crée un plan d'abonnement dans Subscriptions > Plans
# 4. Copie l'ID du plan (ex: P-1AB23456CD789012EF34GHIJ)
# 5. Configure un webhook dans My Apps > Webhooks pointant vers :
#    https://ton-domaine.com/api/payments/paypal/webhook
#    Événements à écouter : BILLING.SUBSCRIPTION.CANCELLED, BILLING.SUBSCRIPTION.SUSPENDED
# 6. Copie l'ID du webhook créé (ex: 1HF48294RJ335721U) dans PAYPAL_WEBHOOK_ID
#    → Permet la vérification cryptographique de chaque événement reçu (sécurité)
# En production, change PAYPAL_MODE=live
PAYPAL_CLIENT_ID=AaBbCc...
PAYPAL_CLIENT_SECRET=EeFfGg...
PAYPAL_PLAN_ID=P-...
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
